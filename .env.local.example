# Configuracao LOCAL completa, com um modelo do Ollama (sem custos e sem chaves reais).
# Copiar para .env:  cp .env.local.example .env   (o .env nao e versionado)
# Valores ficticios: nunca colocar segredos reais neste ficheiro; os segredos vao em ficheiros.
#
# Antes de arrancar, criar os dois ficheiros de segredo (ficam em AgentDATA/secrets/, ignorado
# pelo Git):
#   printf local > AgentDATA/secrets/ollama_key
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))" > AgentDATA/secrets/panel_csrf_secret
# (o Ollama ignora a chave de API, mas o cliente exige um ficheiro nao vazio; o segredo CSRF
# precisa de pelo menos 32 caracteres.)
# Base: docker compose -f compose.dev.yaml up -d  (porta 5434, so loopback)
DATABASE_URL=postgresql+psycopg://marketing_agent:marketing_agent@127.0.0.1:5434/marketing_agent
MONTHLY_BUDGET_REFERENCE_USD=20
BUDGET_WARN_PERCENTS=[50,80,100]
# Modelos locais: o fornecedor "openai" fala com qualquer servidor compativel (aqui o Ollama).
# Quatro papeis: o Revisor usa outro modelo (e outra rubrica) que o Copywriter, e o Designer (que
# escolhe o layout da imagem; obrigatorio no worker) usa o modelo de texto. Sem rota
# `designer_imagem` os fundos sao simulados (gerador falso, custo 0; o worker avisa no arranque).
# `ollama pull qwen2.5:14b` e `ollama pull qwen2.5vl:7b` antes de arrancar o worker.
# Comparacao cega (Plano 2C): o papel `simples` nao e exigido; sem rota `simples` aqui usa a do
# `copywriter` (text + json_schema). Para um modelo proprio, acrescentar a chave "simples".
ROLE_ROUTES={"diretor":{"provider":"openai","model_id":"qwen2.5:14b","capabilities":["text","json_schema"]},"copywriter":{"provider":"openai","model_id":"qwen2.5:14b","capabilities":["text","json_schema"]},"designer":{"provider":"openai","model_id":"qwen2.5:14b","capabilities":["text","json_schema"]},"revisor":{"provider":"openai","model_id":"qwen2.5vl:7b","capabilities":["text","json_schema","image_input"]}}
# Contexto: o Ollama usa 4096 tokens por omissao e TRUNCA EM SILENCIO os prompts mais longos. O
# adaptador fala com o endpoint compativel com a OpenAI, onde nao e possivel definir `num_ctx` por
# pedido; defina-o no servidor: `OLLAMA_CONTEXT_LENGTH=8192 ollama serve` (ou um Modelfile com
# `PARAMETER num_ctx 8192`). Estas variaveis sao do Ollama, nao deste projeto.
# Ollama no mesmo sistema: localhost. No Windows a partir do WSL, usar o IP do anfitriao.
# <IP-do-host-WSL> varia entre instalacoes e a cada reinicio do WSL (ver `ip route show default`):
# OPENAI_BASE_URL=http://<IP-do-host-WSL>:11434/v1
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY_FILE=AgentDATA/secrets/ollama_key
# Painel: o login que o `marketing-agent dev-proxy --login dono@local` injeta, atras do proxy local.
PANEL_ALLOWED_LOGINS=["dono@local"]
PANEL_TRUSTED_PROXY=["127.0.0.1","::1"]
# Hostnames (sem porta) aceites no cabecalho Host (defesa contra DNS rebinding): o painel em
# 127.0.0.1:8000 e o dev-proxy em 127.0.0.1:8001 usam estes dois.
PANEL_ALLOWED_HOSTS=["127.0.0.1","localhost"]
PANEL_CSRF_SECRET_FILE=AgentDATA/secrets/panel_csrf_secret
MAX_MESSAGE_CHARS=4000
# Tetos do plano semanal: publicacoes por semana e por dia que o Diretor pode propor (um plano
# acima do teto e recusado pelo codigo e o Diretor repete ate 3 vezes).
PLAN_MAX_POSTS_PER_WEEK=5
PLAN_MAX_POSTS_PER_DAY=1
# Teto de custo (USD) de um pacote texto e imagem, somando tentativas e voltas do mesmo pedido.
PACKAGE_MAX_COST_USD=1.50
# Precos a custo zero dos modelos locais (sincronizar com `marketing-agent sync-prices`).
MODEL_PRICES_PATH=config/model_prices.local.yaml

# Armazenamento privado local de imagens normalizadas.
MEDIA_DIR=var/media

# Conjuntos de avaliacao da comparacao (um `<nome>.yaml` por conjunto; omissao: evals).
# EVALS_DIR=evals

# Qualidade dos fundos simulados; uma rota paga exige preco confirmado no contrato do motor.
IMAGE_QUALITY=medium
# OPENAI_IMAGES_API_KEY_FILE=AgentDATA/secrets/openai_images_key

# Multiplica apenas tempos de chamada/execucao e guardas relacionadas (1 a 10).
# Para modelos locais lentos, 5 permite chamadas ate 600 s; recuperacao fica mais lenta.
LLM_TIME_MULTIPLIER=5
