# Copiar para .env e ajustar. Valores ficticios: nunca colocar segredos reais neste ficheiro.
# Campos compostos (ROLE_ROUTES, BUDGET_WARN_PERCENTS, PANEL_*) sao JSON.
DATABASE_URL=postgresql+psycopg://marketing_agent:marketing_agent@127.0.0.1:5433/marketing_agent_test
MONTHLY_BUDGET_REFERENCE_USD=20
BUDGET_WARN_PERCENTS=[50,80,100]
ROLE_ROUTES={"diretor":{"provider":"fake","model_id":"fake-1","capabilities":["text","json_schema"]}}
# Caminhos de ficheiros que contem a chave (uma linha); a chave nunca vai no .env.
ANTHROPIC_API_KEY_FILE=AgentDATA/secrets/anthropic_api_key
OPENAI_API_KEY_FILE=AgentDATA/secrets/openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
PANEL_ALLOWED_LOGINS=["owner@example.com"]
PANEL_TRUSTED_PROXY=["127.0.0.1","::1"]
MAX_MESSAGE_CHARS=4000
MODEL_PRICES_PATH=config/model_prices.yaml
