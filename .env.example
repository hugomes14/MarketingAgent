# Copiar para .env e ajustar. Valores ficticios: nunca colocar segredos reais neste ficheiro.
# Campos compostos (ROLE_ROUTES, BUDGET_WARN_PERCENTS, PANEL_*) sao JSON.
# O .env contem apenas campos de Settings: qualquer outra chave (ex.: ANTHROPIC_API_KEY,
# TEST_DATABASE_URL) e rejeitada no arranque. Exportar TEST_DATABASE_URL na shell; as chaves de API
# vao em ficheiros apontados por *_API_KEY_FILE. DATABASE_URL e obrigatorio (sem valor por omissao).
DATABASE_URL=postgresql+psycopg://marketing_agent:marketing_agent@127.0.0.1:5433/marketing_agent_test
MONTHLY_BUDGET_REFERENCE_USD=20
BUDGET_WARN_PERCENTS=[50,80,100]
ROLE_ROUTES={"diretor":{"provider":"fake","model_id":"fake-1","capabilities":["text","json_schema"]}}
# Caminhos de ficheiros que contem a chave (uma linha); a chave nunca vai no .env.
ANTHROPIC_API_KEY_FILE=AgentDATA/secrets/anthropic_api_key
OPENAI_API_KEY_FILE=AgentDATA/secrets/openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
PANEL_ALLOWED_LOGINS=["owner@example.com"]
PANEL_TRUSTED_PROXY=["127.0.0.1","::1"]
# Hostnames (sem porta) aceites no cabecalho Host; qualquer outro recebe 400 (defesa contra DNS
# rebinding). Em producao acrescentar o hostname do `tailscale serve` (ex.: "painel.tailnet.ts.net").
PANEL_ALLOWED_HOSTS=["127.0.0.1","localhost"]
# Ficheiro com o segredo CSRF do painel (>= 32 caracteres), obrigatorio para servir o painel:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))" > AgentDATA/secrets/panel_csrf_secret
PANEL_CSRF_SECRET_FILE=AgentDATA/secrets/panel_csrf_secret
MAX_MESSAGE_CHARS=4000
# Tetos do plano semanal: publicacoes por semana e por dia que o Diretor pode propor.
PLAN_MAX_POSTS_PER_WEEK=5
PLAN_MAX_POSTS_PER_DAY=1
MODEL_PRICES_PATH=config/model_prices.yaml

# Armazenamento privado local de imagens normalizadas.
MEDIA_DIR=var/media
